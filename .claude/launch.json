{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "openetv-server",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "PYTHONPATH=tools .venv/bin/python -m etvlib --port 8766 --no-browser"],
      "port": 8766
    },
    {
      "name": "openetv-streamlit",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.headless", "true", "--server.port", "8501"],
      "port": 8501
    }
  ]
}
